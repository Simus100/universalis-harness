# ============================================================================
# .env di esempio — copialo in `.env` e riempi SOLO quello che ti serve.
#
#   cp .env.example .env
#   chmod 600 .env            # contiene una password: non deve essere leggibile da altri
#
# `.env` è ignorato da git: non finisce MAI nel repository.
# Le chiavi API dei provider NON stanno qui per forza: si possono incollare dal pannello
# «🔑 chiavi» della dashboard, che le verifica e le salva in ~/.pi/agent/auth.json (0600).
# In alternativa: `node scripts/onboarding-provider.mjs` dice cosa manca.
# ============================================================================

# --- accesso alla dashboard (obbligatorio) ----------------------------------
# Senza DASH_PASSWORD il server ne genera una casuale a ogni avvio e non la stampa:
# impostala, oppure usa il pannello chiavi dopo il primo avvio.
DASH_USER=pi
DASH_PASSWORD=cambiami

# Interfaccia e porta: 0.0.0.0 per raggiungerla dalla rete, 127.0.0.1 per il solo locale.
DASH_HOST=0.0.0.0
# DASH_PORT non è letta dal file: la porta si passa con `--port 8420` (o la unit systemd).

# --- percorsi (facoltativi: i default sono dentro il progetto) --------------
# DASH_ROOT=<cartella dei file che l'agente può leggere e scrivere>   default: cartella corrente
# DASH_MEDIA_DIR=<file generati: immagini, goal, memoria, upload>    default: ./media
# DASH_SESSION_DIR=<conversazioni salvate>                          default: ./sessions
# DASH_SKILLS_DIR=<skill in formato Agent Skills>                   default: ./skills
# DASH_BACKUP_DIR=<archivi di sessions/ e media/>                   default: ./backups

# --- provider (una delle due strade) ---------------------------------------
# Strada A: chiave in questo file (variabile letta all'avvio).
# GEMINI_API_KEY=la-tua-chiave-google
# Strada B: pannello «🔑 chiavi» nella dashboard → ~/.pi/agent/auth.json
#   (deepseek, google, ecc. — la dashboard dice quali provider sono pronti)

# --- comportamento dei tool (facoltativo) ----------------------------------
# Subagent: auto (solo nei turni di ricognizione) · on (sempre) · off
# DASH_SUBAGENT=auto
# Tetto ai risultati dei tool, in caratteri: oltre, restano inizio e fine con la nota per rileggere
# DASH_LIMITE_RISULTATO=10000
# Controllo del turno: on (default) | off — guardia anti-loop e limite dei risultati
# DASH_CONTROLLO=on
# Guardie: passi senza progresso, ripetizioni, tetto assoluto di passi per turno
# DASH_GUARDIA_PASSI=15
# DASH_GUARDIA_RIPETIZIONI=3
# DASH_GUARDIA_MAX=120

# --- servizi locali (spenti di default: accendili dalla dashboard) ---------
# Decision_M (decisore tipizzato, ~5,7 GB di RAM quando acceso)
# DASH_TIMESTRAL=on
# DASH_TIMESTRAL_MAX_UPLOAD_MB=8

# --- browser pilotato (facoltativo) ----------------------------------------
# Richiede `agent-browser` e un utente dedicato: vedi docs/RICOSTRUZIONE.md §1
# DASH_BROWSER_USER=pi-browser
# DASH_BROWSER_BIN=/usr/local/bin/pbrowser

# --- estensioni del motore (normalmente automatiche) -----------------------
# Dopo `npm install` le estensioni stanno in ./node_modules e vengono trovate da sole.
# Servono solo se ne usi una copia esterna:
# DASH_SUBAGENT_EXT=/percorso/pi-subagents/index.ts
