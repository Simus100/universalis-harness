<script>
const DATA = {{ data_json|safe }};
const T = DATA.teams;
const M = DATA.matches;

/* ---------------- utility ---------------- */
const pct = (x,d=1) => (x*100).toFixed(d)+'%';
const q2 = x => (x==null?'—':x.toFixed(2).replace('.',','));
const evfmt = x => (x==null?'—':(x>=0?'+':'')+(x*100).toFixed(1)+'%');
const evClass = x => x==null?'ev-neu':(x>=0.02?'ev-pos':(x>-0.02?'ev-neu':'ev-neg'));
const stars = n => '★'.repeat(n)+'☆'.repeat(5-n);
const fieldTeams = [...new Set(M.flatMap(m=>[m.home,m.away]))];
const marketOrder = ['1','X','2','1X','12','X2','GG','NG','O1.5','U1.5','O2.5','U2.5','O3.5','U3.5'];
const selLabel = s => ({'1':'1 (casa)','X':'X (pari)','2':'2 (ospite)','1X':'1X (casa o pari)','12':'12 (no pari)',
  'X2':'X2 (pari o ospite)','GG':'GG (entrambe segnano)','NG':'NG (no gol entrambe)','O1.5':'Over 1.5','U1.5':'Under 1.5',
  'O2.5':'Over 2.5','U2.5':'Under 2.5','O3.5':'Over 3.5','U3.5':'Under 3.5'}[s]||s);
const dayName = d => ({ven:'Venerdì 18',sab:'Sabato 19',dom:'Domenica 20'}[d]);
const statusLabel = s => ({upcoming:'da giocare',live:'in corso',played:'conclusa'}[s]);
const scorersM = m => m.scorers || '—';

/* ---------------- HERO ---------------- */
document.getElementById('heroMeta').innerHTML = `
  <span class="chip">📅 <b>${DATA.meta.periodo}</b></span>
  <span class="chip">⚽ <b>10</b> partite · 20 squadre</span>
  <span class="chip">🧮 modello: <b>Dixon-Coles + mercato</b></span>
  <span class="chip">💰 <b>${DATA.value_top.length}</b> selezioni con valore</span>
  <span class="chip">📌 ${DATA.meta.prossima}</span>`;

/* ---------------- KPI ---------------- */
(function(){
  const upcoming = M.filter(m=>m.status==='upcoming').length;
  const best = DATA.value_top[0];
  const top = DATA.schedine.find(s=>s.code==='D');
  document.getElementById('kpis').innerHTML = `
    <div class="kpi"><div class="lbl">Partite da giocare</div><div class="val">${upcoming}<span style="font-size:15px;color:var(--dim)">/10</span></div>
      <div class="sub2">${M.filter(m=>m.status==='live').length} in corso · ${M.filter(m=>m.status==='played').length} conclusa</div></div>
    <div class="kpi"><div class="lbl">Miglior valore atteso</div><div class="val ev-pos">${evfmt(best.ev)}</div>
      <div class="sub2">${best.partita} · ${selLabel(best.sel)} a ${q2(best.q)}</div></div>
    <div class="kpi"><div class="lbl">Schedina D (singola)</div><div class="val">${q2(top.quota)}</div>
      <div class="sub2">probabilità ${pct(top.prob)} · stake ¼ Kelly ${(top.kelly*100).toFixed(2)}% del bankroll</div></div>
    <div class="kpi"><div class="lbl">Difesa migliore</div><div class="val">Roma</div><div class="sub2">1 gol subito in 4 gare, 3 clean sheet</div></div>
    <div class="kpi"><div class="lbl">Attacco migliore</div><div class="val">Inter</div><div class="sub2">13 gol in 4 gare (3,25 di media)</div></div>`;
})();

/* ---------------- SINTESI ---------------- */
(function(){
  const li = [
    `Scontro al vertice: <b>Roma-Inter</b> mette di fronte le uniche due squadre a punteggio pieno (12 punti). Il modello assegna
     ${pct(M[3].final_probs.home,0)} alla Roma, ${pct(M[3].final_probs.draw,0)} al pareggio e ${pct(M[3].final_probs.away,0)} all'Inter,
     con ${M[3].expected_goals} gol attesi: la partita più equilibrata del turno (e la più aperta tatticamente).`,
    `La capolista <b>Roma</b> ha la miglior difesa del campionato (1 gol subito) e non perde in casa da 14 gare, ma l'Inter non vince
     all'Olimpico dal 2016 e ha vinto 5 trasferte consecutive in casa giallorossa con 11-2 complessivo: la statistica più pesante del turno.`,
    `<b>Juventus-Atalanta</b>: 12 pareggi su 19 incroci dal 2017 e Atalanta imbattuta da 8 trasferte a Torino. La Juve ha 7 indisponibili
     e arriva dal 5-0 al NEC in Europa League: il modello vede il <b>GG</b> (${pct(M[8].markets.GG.p,0)}), non il segno 1 a tutti i costi.`,
    `<b>Cagliari</b> e <b>Como</b> sono le sorprese: i sardi hanno la difesa più efficace su azione (1 gol) e sono in corsa per il record
     delle prime tre trasferte vinte; i lariani hanno 10 punti con una partita in meno e hanno vinto a Napoli e col Lipsia.`,
    `In coda <b>Venezia</b> (0 punti) e <b>Bologna</b> (1 punto, cambio di panchina con Palladino) sono le situazioni più fragili:
     a Firenze e Genova si giocano già partite-salvezza.`,
    `<b>Milan</b> favoritissimo sul Lecce (${pct(M[9].final_probs.home,0)}), ma attenzione: tutti i 7 gol rossoneri in campionato sono
     arrivati nell'ultima mezz'ora, un dato che sposta il focus sui mercati "tempo" più che sul 1X2.`
  ];
  const tot = M.filter(m=>m.status==='upcoming').reduce((a,m)=>a+m.expected_goals,0);
  const avg = tot/M.filter(m=>m.status==='upcoming').length;
  li.push(`<b>Gol attesi complessivi</b> nelle 7 gare ancora da giocare: <b>${tot.toFixed(1)}</b> (${avg.toFixed(2)} per partita,
    contro una media di campionato di 3,02). È un turno "magro": molte squadre arrivano con attacchi in difficoltà
    (Parma, Genoa, Bologna, Torino, Atalanta, Fiorentina) e difese solide. Le partite più prolifiche secondo il modello
    sono Roma-Inter (${M[3].expected_goals}) e Milan-Lecce (${M[9].expected_goals}).`);
  document.getElementById('sintesiList').innerHTML = li.map(t=>`<li>${t}</li>`).join('');
  const t = DATA.schedine.find(s=>s.code==='D');
  const row = t.dettaglio[0];
  const tMatch = M.find(x=>x.id===row.mid);
  const bestMkt = row.sel==='1'?tMatch.market_probs.home:(row.sel==='2'?tMatch.market_probs.away:
    (row.sel==='X'?tMatch.market_probs.draw:(row.sel==='1X'?tMatch.market_probs.home+tMatch.market_probs.draw:
    (row.sel==='X2'?tMatch.market_probs.away+tMatch.market_probs.draw:tMatch.market_probs.home+tMatch.market_probs.away))));
  document.getElementById('topPick').innerHTML = `
    <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
      <div style="font-size:22px;font-weight:800">${row.partita}</div>
      <span class="pill pos">${selLabel(row.sel)}</span>
      <span class="pill eu">${row.ora}</span>
    </div>
    <div class="summary" style="margin-top:14px">
      <div class="sumbox"><div class="lbl">Quota</div><div class="v">${q2(row.q)}</div></div>
      <div class="sumbox"><div class="lbl">Probabilità modello</div><div class="v">${pct(row.p)}</div></div>
      <div class="sumbox"><div class="lbl">Probabilità mercato</div><div class="v" style="color:var(--dim)">${pct(bestMkt)}</div></div>
      <div class="sumbox"><div class="lbl">Valore atteso</div><div class="v ev-pos">${evfmt(row.ev)}</div></div>
    </div>
    <p class="small" style="margin-top:12px">Il modello stima la Roma vincente al ${pct(row.p)} contro un mercato che la prezza
    intorno al ${pct(bestMkt)}: nasce un valore atteso positivo del ${evfmt(row.ev)}. È la sola giocata singola che il modello
    promuove fra le 7 partite ancora da giocare — tutte le altre hanno valore atteso nullo o negativo.</p>`;
})();

/* ---------------- SCENARI DI VETTA ---------------- */
(function(){
  const rom=T['Roma'].pts, inter=T['Inter'].pts, como=T['Como'].pts, laz=T['Lazio'].pts;
  const rows = [
    {esito:'Vittoria Roma (39%)', r:rom+3, i:inter, nota:`La Roma sale a ${rom+3} e si porta a +3 sull'Inter: Como e Lazio (a ${como} e ${laz}) possono al massimo restare a -2.`},
    {esito:'Pareggio (27%)', r:rom+1, i:inter+1, nota:`Roma e Inter restano appaiate a ${rom+1}; Como e Lazio, con una vittoria, le raggiungono a quota ${como+3}: la classifica si comprime.`},
    {esito:'Vittoria Inter (35%)', r:rom, i:inter+3, nota:`L'Inter sale a ${inter+3} e allunga a +3 sulla Roma, che resta a ${rom}; per i nerazzurri sarebbe la sesta vittoria consecutiva all'Olimpico e il primo vero strappo stagionale.`},
  ];
  document.getElementById('scenari').innerHTML = rows.map(r=>`
    <div style="display:grid;grid-template-columns:190px 1fr;gap:12px;padding:10px 0;border-bottom:1px dashed rgba(255,255,255,.08)">
      <div><b>${r.esito}</b><br><span class="small">Roma ${r.r} pt · Inter ${r.i} pt</span></div>
      <div class="small" style="color:#c6d2ea">${r.nota}</div>
    </div>`).join('') +
    `<p class="small" style="margin-top:12px">Nota: le percentuali sono quelle del modello ancorate al mercato. La 5ª giornata
     è l'ultima prima della sosta per la Nations League: chi sbaglia ha tre settimane per rimuginarci sopra.</p>`;
})();

/* ---------------- METODO mini table ---------------- */
(function(){
  const rows = [
    ['Forma (ultime 4)', 'sequenza V/N/P dal campionato'],
    ['Gol fatti / subiti', 'per partita e per split casa-trasferta'],
    ['xG previsti (λ)', 'modello interno + fonti esterne'],
    ['Precedenti (H2H)', 'ultimi 4-10 incroci e serie attive'],
    ['Indisponibili', 'infortunati e squalificati verificati'],
    ['Quote reali', '1X2 Snai/ADM + mercati derivati'],
    ['Contesto', 'coppe europee, cambi di panchina, pausa']
  ];
  document.getElementById('methodTbl').innerHTML = rows.map(r=>
    `<tr><td><b>${r[0]}</b></td><td style="text-align:right;color:var(--dim)">${r[1]}</td></tr>`).join('');
})();

/* ---------------- CLASSIFICA ---------------- */
(function(){
  const cols = [
    {k:'pos',t:'#',w:'34px'},{k:'team',t:'Squadra',al:'left'},{k:'pts',t:'Pt'},{k:'g',t:'G'},
    {k:'v',t:'V'},{k:'n',t:'N'},{k:'p',t:'P'},{k:'gf',t:'GF'},{k:'ga',t:'GS'},{k:'gd',t:'DR'},
    {k:'ppg',t:'PPG'},{k:'gpm',t:'GF/g'},{k:'gapm',t:'GS/g'},{k:'form',t:'Forma'},{k:'bar',t:'Rendimento'}
  ];
  const rows = Object.entries(T).map(([name,t])=>({team:name,...t,gd:t.gf-t.ga,ppg:t.pts/t.g,
    gpm:t.gf/t.g,gapm:t.ga/t.g}));
  let sortKey='pts', asc=false, filter='', onlyField=true;
  const maxPts = Math.max(...rows.map(r=>r.pts));
  function render(){
    const head = document.querySelector('#cls thead');
    const body = document.querySelector('#cls tbody');
    head.innerHTML = '<tr>'+cols.map(c=>`<th data-k="${c.k}" class="${sortKey===c.k?'sorted'+(asc?' asc':''):''}"
      style="text-align:${c.al||'center'}">${c.t}</th>`).join('')+'</tr>';
    let list = rows.filter(r=>!filter || r.team.toLowerCase().includes(filter));
    if(onlyField) list = list.filter(r=>fieldTeams.includes(r.team));
    list.sort((a,b)=> (typeof a[sortKey]==='string') ? (asc? a[sortKey].localeCompare(b[sortKey]) : b[sortKey].localeCompare(a[sortKey]))
                                                   : (asc? a[sortKey]-b[sortKey] : b[sortKey]-a[sortKey]));
    body.innerHTML = list.map(r=>{
      const zone = r.pos<=4?'pos':(r.pos<=6?'eu':(r.pos>=17?'releg':''));
      const inField = fieldTeams.includes(r.team);
      return `<tr style="${inField?'background:rgba(34,227,164,.045)':''}">
        <td><span class="pill ${zone}">${r.pos}</span></td>
        <td class="team">${r.team} ${inField?'<span class="small" style="color:var(--green)">●</span>':''}</td>
        <td><b>${r.pts}</b></td><td>${r.g}</td><td>${r.v}</td><td>${r.n}</td><td>${r.p}</td>
        <td>${r.gf}</td><td>${r.ga}</td><td>${r.gd>0?'+':''}${r.gd}</td>
        <td>${r.ppg.toFixed(2).replace('.',',')}</td>
        <td>${r.gpm.toFixed(2).replace('.',',')}</td>
        <td>${r.gapm.toFixed(2).replace('.',',')}</td>
        <td><span class="form">${r.forma.split(' ').map(f=>`<i class="f-${f}">${f}</i>`).join('')}</span></td>
        <td><div class="bar"><span style="width:${(r.pts/12*100).toFixed(0)}%"></span></div></td>
      </tr>`;
    }).join('');
    head.querySelectorAll('th').forEach(th=>th.onclick=()=>{
      const k=th.dataset.k; if(k===sortKey) asc=!asc; else {sortKey=k;asc=false;} render();
    });
  }
  document.getElementById('q').oninput = e => { filter = e.target.value.toLowerCase().trim(); render(); };
  document.getElementById('onlyField').onchange = e => { onlyField = e.target.checked; render(); };
  render();
})();

/* ---------------- MATCH CARDS ---------------- */
(function(){
  const filters = [['all','Tutte'],['ven','Venerdì 18'],['sab','Sabato 19'],['dom','Domenica 20'],
                   ['upcoming','Da giocare'],['live','In corso'],['played','Conclusa'],['value','Con valore atteso > 0']];
  let cur='all';
  const fbox = document.getElementById('filters');
  fbox.innerHTML = filters.map(f=>`<button class="fbtn${f[0]==='all'?' on':''}" data-f="${f[0]}">${f[1]}</button>`).join('');
  fbox.querySelectorAll('.fbtn').forEach(b=>b.onclick=()=>{
    cur=b.dataset.f; fbox.querySelectorAll('.fbtn').forEach(x=>x.classList.toggle('on',x===b)); render();
  });

  function bar(label, p, mkt, tag){
    return `<div class="pbox" title="${tag||''}">
      <div class="lbl">${label}</div>
      <div class="big">${pct(p)}</div>
      <div class="pbar"><span style="width:${(p*100).toFixed(1)}%"></span></div>
      <div class="mini" style="margin-top:6px">mercato ${pct(mkt)}</div>
      <div class="pbar mkt"><span style="width:${(mkt*100).toFixed(1)}%"></span></div>
    </div>`;
  }

  function marketsTable(m){
    return `<table class="mini-tbl">` +
      marketOrder.filter(s=>m.markets[s]).map(s=>{
        const v=m.markets[s];
        if(!v.q && v.p<0.08) return '';
        return `<tr><td>${selLabel(s)}</td>
          <td style="text-align:right">${pct(v.p,1)}</td>
          <td style="text-align:right;color:var(--dim)">${v.q?(v.qsrc==='stima'?'≈':'' )+q2(v.q):'≈'+q2(v.fair)}</td>
          <td style="text-align:right" class="${v.ev==null?'ev-neu':evClass(v.ev)}">${v.ev==null?'—':evfmt(v.ev)}</td></tr>`;
      }).join('') + `</table><p class="small">Quota con “≈” = quota equa stimata (1/probabilità), non rilevata sul mercato.</p>`;
  }

  function heat(m){
    const max = m.model_cs[0].p;
    let h = '<div class="heat-hdr">righe = gol ' + m.home + ' · colonne = gol ' + m.away + '</div><div class="heat">';
    for(let x=0;x<5;x++) for(let y=0;y<5;y++){
      const cell = m.heat.find(c=>c.s===`${x}-${y}`) || {p:0};
      const a = Math.min(1, cell.p/(max||1));
      h += `<div style="background:rgba(34,227,164,${(a*0.95).toFixed(2)});color:${a>0.5?'#04121a':'#cfe8ff'}"
        title="${x}-${y}: ${pct(cell.p,2)}">${cell.p>=0.03?(cell.p*100).toFixed(0):''}</div>`;
    }
    return h+'</div>';
  }

  function render(){
    let list = M.filter(m=>{
      if(cur==='all') return true;
      if(['ven','sab','dom'].includes(cur)) return m.day===cur;
      if(cur==='value') return m.best_value && m.best_value.ev>0;
      return m.status===cur;
    });
    document.getElementById('matchList').innerHTML = list.map(m=>{
      const fp=m.final_probs, mk=m.market_probs, mo=m.model_probs;
      const tagm = m.status==='upcoming'?`<span class="status st-upcoming">da giocare</span>`:
        (m.status==='live'?`<span class="status st-live">● in corso</span>`:`<span class="status st-played">conclusa</span>`);
      return `<div class="mcard" id="card-${m.id}">
        <div class="top" onclick="this.parentNode.classList.toggle('open')">
          <div class="row1">
            <span class="daytag">${dayName(m.day)} · ${m.time}</span>
            ${tagm}
            ${m.status!=='upcoming'?`<span class="scorebox">${m.score}</span>`:''}
            <span class="mt-meta">${m.venue}<br>${m.tv}</span>
          </div>
          <div class="teams-row">
            <span class="tname">${m.home}</span>
            <span class="vs">vs</span>
            <span class="tname">${m.away}</span>
            <span class="stars" title="confidenza ${m.confidence}/5">${stars(m.confidence)}</span>
            <span class="small" style="margin-left:auto">${m.expected_goals} gol attesi · lean <b>${m.model_lean}</b> (${pct(m.model_lean_p,0)})</span>
          </div>
          <div class="probs3">
            ${bar('1 · '+m.home, fp.home, mk.home, 'probabilità modello finale vs mercato')}
            ${bar('X · pareggio', fp.draw, mk.draw)}
            ${bar('2 · '+m.away, fp.away, mk.away)}
          </div>
        </div>
        <div class="details">
          <div class="dgrid">
            <div class="block">
              <h4>Lettura della partita</h4>
              <p><b>Momento:</b> ${m.formNote || ''}</p>
              <p><b>Precedenti:</b> ${m.h2h}</p>
              <p><b>Contesto:</b> ${m.note}</p>
              ${m.lesson?`<p style="color:var(--green)"><b>Verifica:</b> ${m.lesson}</p>`:''}
            </div>
            <div class="block">
              <h4>Indisponibili</h4>
              <p><b>${m.home}:</b> ${m.absences.home.length?m.absences.home.join(', '):'nessuno'}</p>
              <div class="taglist">${m.absences.home.map(a=>`<span class="tg">${a}</span>`).join('')}</div>
              <p style="margin-top:10px"><b>${m.away}:</b> ${m.absences.away.length?m.absences.away.join(', '):'nessuno'}</p>
              <div class="taglist">${m.absences.away.map(a=>`<span class="tg">${a}</span>`).join('')}</div>
              <h4 style="margin-top:14px">Gol attesi (λ)</h4>
              <p>${m.home} ${m.lambda_home} — ${m.away} ${m.lambda_away} <span class="small">(fonte: ${m.xg_src})</span></p>
              <p class="small">Overround del mercato: ${(m.overround*100).toFixed(1)}% — margine del banco sul 1X2.</p>
            </div>
            <div class="block">
              <h4>Mercati e valore</h4>
              ${marketsTable(m)}
            </div>
            <div class="block">
              <h4>Risultati esatti del modello</h4>
              <table class="mini-tbl">${m.model_cs.slice(0,5).map(c=>`<tr><td>${c.s}</td><td>${pct(c.p,1)}</td></tr>`).join('')}</table>
              <h4 style="margin-top:14px">Giocata consigliata</h4>
              <p><b>${m.pick}</b></p>
              ${m.best_value?`<p class="small">Miglior valore statistico: <b>${selLabel(m.best_value.sel)}</b>
                ${m.best_value.q?'a '+q2(m.best_value.q):''} · p ${pct(m.best_value.p)} · EV
                <span class="${evClass(m.best_value.ev)}">${evfmt(m.best_value.ev)}</span></p>`:''}
              ${m.scorers?`<p class="small">Marcatori: ${m.scorers}</p>`:''}
            </div>
            <div class="block">
              <h4>Mappa risultato</h4>
              ${heat(m)}
            </div>
          </div>
        </div>
      </div>`;
    }).join('');
  }
  window.__renderMatches = render;
  render();
})();

/* ---------------- TABELLA RIEPILOGO ---------------- */
(function(){
  const thead = document.querySelector('#overview thead');
  const tb = document.querySelector('#overview tbody');
  thead.innerHTML = `<tr><th style="text-align:left">Partita</th><th>Quando</th><th>1</th><th>X</th><th>2</th>
    <th>Gol attesi</th><th>Esito più probabile</th><th>Miglior quota</th><th>Confidenza</th><th>Stato</th></tr>`;
  tb.innerHTML = M.map(m=>{
    const f=m.final_probs;
    const bv=m.best_value;
    return `<tr style="cursor:pointer" onclick="openCard('${m.id}')">
      <td class="team">${m.home} – ${m.away}</td>
      <td>${dayName(m.day).split(' ')[0].slice(0,3)} ${m.time}</td>
      <td${f.home>f.draw&&f.home>f.away?' style="color:var(--green);font-weight:700"':''}>${pct(f.home,0)}</td>
      <td${f.draw>f.home&&f.draw>f.away?' style="color:var(--green);font-weight:700"':''}>${pct(f.draw,0)}</td>
      <td${f.away>f.draw&&f.away>f.home?' style="color:var(--green);font-weight:700"':''}>${pct(f.away,0)}</td>
      <td>${m.expected_goals}</td>
      <td><span class="pill eu">${selLabel2(m.model_lean,m)}</span></td>
      <td>${bv?selLabel2(bv.sel,m)+' <b>'+q2(bv.q)+'</b>':'—'}
        ${bv&&bv.ev>0?'<span class="small ev-pos">'+evfmt(bv.ev)+'</span>':''}</td>
      <td class="stars">${stars(m.confidence)}</td>
      <td><span class="status st-${m.status==='live'?'live':(m.status==='played'?'played':'upcoming')}">${statusLabel(m.status)}</span></td>
    </tr>`;
  }).join('');
})();
function selLabel2(sel, m){
  if(sel==='1') return m.home;
  if(sel==='2') return m.away;
  if(sel==='X') return 'pareggio';
  return selLabel(sel);
}
function openCard(id){
  const c=document.getElementById('card-'+id);
  if(!c) return;
  c.classList.add('open');
  if(c.scrollIntoView) c.scrollIntoView({behavior:'smooth',block:'center'});
}
window.openCard=openCard;
window.toggleAll = () => {
  const cards=[...document.querySelectorAll('.mcard')];
  const anyClosed = cards.some(c=>!c.classList.contains('open'));
  cards.forEach(c=>c.classList.toggle('open', anyClosed));
};

/* ---------------- SIMULATORE ---------------- */
const slip = new Map();
function renderSim(){
  const playable = M.filter(m=>m.status==='upcoming');
  document.getElementById('simRows').innerHTML = playable.map(m=>{
    const opts = marketOrder.filter(s=>m.markets[s] && m.markets[s].q && m.markets[s].qsrc==='real');
    return `<div class="sim-row">
      <span class="nm">${m.home} – ${m.away}<br><span class="small">${m.date} ${m.time}</span></span>
      ${opts.map(s=>{
        const v=m.markets[s], on = slip.get(m.id)===s;
        return `<button class="selbtn${on?' on':''}" onclick="pick('${m.id}','${s}')">${s}<span class="q">${q2(v.q)}</span></button>`;
      }).join('')}
    </div>`;
  }).join('');
  updateSim();
}
function pick(mid, sel){ if(slip.get(mid)===sel) slip.delete(mid); else slip.set(mid, sel); renderSim(); }
function clearSlip(){ slip.clear(); renderSim(); }
window.pick=pick; window.clearSlip=clearSlip;
function loadSlip(code){
  clearSlip();
  const s = DATA.schedine.find(x=>x.code===code);
  s.dettaglio.forEach(d=>slip.set(d.mid, d.sel));
  renderSim();
  document.getElementById('simMsg').innerHTML = `<b>Schedina ${code} caricata</b>: ${s.nome}. ${s.note||''}`;
}
window.loadSlip=loadSlip;
function updateSim(){
  let q=1,p=1,n=0;
  slip.forEach((sel,mid)=>{
    const m=M.find(x=>x.id===mid); const v=m.markets[sel];
    if(v&&v.q){q*=v.q;p*=v.p;n++;}
  });
  const kf = document.getElementById('kf').value/100;
  const bank = parseFloat(document.getElementById('bank').value)||0;
  const ev = n? p*q-1 : null;
  const stake = (n && ev>0) ? bank * kf * ev/(q-1) : 0;
  document.getElementById('simSummary').innerHTML = `
    <div class="sumbox"><div class="lbl">Selezioni</div><div class="v">${n}</div></div>
    <div class="sumbox"><div class="lbl">Quota totale</div><div class="v">${n?q2(q):'—'}</div></div>
    <div class="sumbox"><div class="lbl">Probabilità combinata</div><div class="v">${n?pct(p):'—'}</div></div>
    <div class="sumbox"><div class="lbl">Valore atteso</div><div class="v ${evClass(ev)}">${evfmt(ev)}</div></div>
    <div class="sumbox"><div class="lbl">Stake suggerito (¼ Kelly)</div><div class="v">${stake>0?stake.toFixed(2)+' €':'0 €'}</div>
      <div class="small">${stake>0?(stake/bank*100).toFixed(2)+'% del bankroll':'EV non positivo: non giocare'}</div></div>
    <div class="sumbox"><div class="lbl">Ritorno potenziale</div><div class="v">${n?(bank&&stake>0?(stake*q).toFixed(2)+' €':'—'):'—'}</div>
      <div class="small">sullo stake suggerito</div></div>`;
  document.getElementById('simMsg').innerHTML = n===0
    ? 'Seleziona un esito per partita. Le quote combinate assumono l\'indipendenza fra le partite.'
    : (n===1 ? 'Una sola selezione: è la forma di puntata con il minor impatto del margine bancario.'
             : `${n} selezioni: il margine del banco si moltiplica. Valuta se le prime ${n-1} selezioni sono davvero solide.`);
}
['kf','bank'].forEach(id=>document.addEventListener('input',e=>{
  if(e.target.id===id){
    if(id==='kf'){const v=+e.target.value; document.getElementById('kfLbl').textContent=
      v===25?'¼':(v===50?'½':(v===100?'pieno':v/100));}
    updateSim();
  }
}));
renderSim();

/* ---------------- SCHEDINE ---------------- */
(function(){
  document.getElementById('schedineBox').innerHTML = DATA.schedine.map(s=>{
    const rows = s.dettaglio.map(d=>`<li><span>${d.partita} <span class="small" style="color:var(--dim)">${d.ora}</span></span>
      <span><span class="pill eu">${d.sel}</span> <b>${q2(d.q)}</b> <span class="small ${evClass(d.ev)}">${evfmt(d.ev)}</span></span></li>`).join('');
    return `<div class="scard">
      <span class="tg2">${s.tag}</span>
      <h3>${s.nome}</h3>
      <ul>${rows}</ul>
      <div class="foot">
        <div><div class="lbl">Quota</div><div class="v">${q2(s.quota)}</div></div>
        <div><div class="lbl">Probabilità</div><div class="v">${pct(s.prob)}</div></div>
        <div><div class="lbl">Valore atteso</div><div class="v ${evClass(s.ev)}">${evfmt(s.ev)}</div></div>
        <div><div class="lbl">Stake</div><div class="v" style="font-size:14px">${s.stake}</div></div>
      </div>
      <p class="note">${s.note||''}</p>
      <p class="note"><b>Simulazione su 100 ipotetiche giocate:</b> vinte ${(s.prob*100).toFixed(0)},
        perse ${(100-s.prob*100).toFixed(0)}. Ritorno teorico ${((s.prob*s.quota)*100).toFixed(0)} € su 100 € giocati.</p>
    </div>`;
  }).join('');
})();

/* ---------------- VALUE / AVOID ---------------- */
(function(){
  const row = (r,cls)=>`<tr><td>${r.partita}<br><span class="small" style="color:var(--dim)">${selLabel(r.sel)} · ${r.ora}</span></td>
    <td style="text-align:right">${pct(r.p)}</td>
    <td style="text-align:right">${q2(r.q)}</td>
    <td style="text-align:right" class="${cls}">${evfmt(r.ev)}</td>
    <td style="text-align:right">${r.kelly?(r.kelly*100).toFixed(2)+'%':'—'}</td></tr>`;
  document.getElementById('valueTbl').innerHTML =
    `<tr><td><b>Partita / esito</b></td><td style="text-align:right"><b>Prob.</b></td><td style="text-align:right"><b>Quota</b></td>
     <td style="text-align:right"><b>EV</b></td><td style="text-align:right"><b>¼ Kelly</b></td></tr>` +
    DATA.value_top.map(r=>row(r,evClass(r.ev))).join('');
  document.getElementById('avoidTbl').innerHTML =
    `<tr><td><b>Partita / esito</b></td><td style="text-align:right"><b>Prob.</b></td><td style="text-align:right"><b>Quota</b></td>
     <td style="text-align:right"><b>EV</b></td><td style="text-align:right"><b>¼ Kelly</b></td></tr>` +
    DATA.avoid.map(r=>row(r,'ev-neg')).join('');
})();

/* ---------------- GRAFICI ---------------- */
(function(){
  // scatter attacco vs difesa
  const W=560,H=360,pad=48;
  const teams = Object.entries(T).map(([n,t])=>({n,gf:t.gf/t.g,ga:t.ga/t.g,field:fieldTeams.includes(n)}));
  const maxX = Math.max(...teams.map(t=>t.gf))*1.12, maxY = Math.max(...teams.map(t=>t.ga))*1.12;
  const X = v => pad + (v/maxX)*(W-pad-24);
  const Y = v => H-pad - (1 - v/maxY)*(H-pad-24);
  let svg = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Scatter attacco difesa">
    <rect x="0" y="0" width="${W}" height="${H}" fill="none"/>
    <g stroke="rgba(255,255,255,.09)">`;
  for(let i=0;i<=4;i++){
    const xx=pad+i*(W-pad-24)/4, yy=pad+i*(H-pad-24)/4;
    svg += `<line x1="${xx}" y1="${pad}" x2="${xx}" y2="${H-pad}"/><line x1="${pad}" y1="${yy}" x2="${W-24}" y2="${yy}"/>`;
  }
  svg += `</g><text x="${W/2}" y="${H-8}" fill="#93a4c4" font-size="11" text-anchor="middle">gol fatti a partita →</text>
    <text x="14" y="${H/2}" fill="#93a4c4" font-size="11" transform="rotate(-90 14 ${H/2})" text-anchor="middle">← gol subiti a partita (più in alto = difesa migliore)</text>`;
  teams.forEach(t=>{
    svg += `<g><circle cx="${X(t.gf).toFixed(1)}" cy="${Y(t.ga).toFixed(1)}" r="${t.field?7:5}"
      fill="${t.field?'#22e3a4':'#54688c'}" opacity="${t.field?.95:.6}">
      <title>${t.n}: ${t.gf.toFixed(2)} gol fatti, ${t.ga.toFixed(2)} subiti a partita</title></circle>
      <text x="${(X(t.gf)+10).toFixed(1)}" y="${(Y(t.ga)+4).toFixed(1)}" font-size="10.5"
      fill="${t.field?'#e8eefc':'#93a4c4'}">${t.n}</text></g>`;
  });
  document.getElementById('scatter').innerHTML = svg+'</svg>';

  // barre gol attesi
  const rows = M.map(m=>({m, tot:m.lambda_home+m.lambda_away}));
  const Wb = 560, rowh = 26, Hb = rows.length*rowh+30;
  const maxT = Math.max(...rows.map(r=>r.tot))*1.1;
  let svg2 = `<svg viewBox="0 0 ${Wb} ${Hb}">`;
  rows.forEach((r,i)=>{
    const y = i*rowh+12;
    const wH = (r.m.lambda_home/maxT)*(Wb-190);
    const wA = (r.m.lambda_away/maxT)*(Wb-190);
    svg2 += `<text x="0" y="${y+11}" font-size="11" fill="#c6d2ea">${r.m.home}–${r.m.away}</text>
      <rect x="150" y="${y}" width="${wH.toFixed(1)}" height="15" rx="4" fill="#22e3a4" opacity=".9">
        <title>${r.m.home}: ${r.m.lambda_home} gol attesi</title></rect>
      <rect x="${150+wH.toFixed(1)}" y="${y}" width="${wA.toFixed(1)}" height="15" rx="4" fill="#5b8cff" opacity=".9">
        <title>${r.m.away}: ${r.m.lambda_away} gol attesi</title></rect>
      <text x="${(150+wH+wA+8).toFixed(1)}" y="${y+11}" font-size="10.5" fill="#93a4c4">${r.tot.toFixed(2)}</text>`;
  });
  document.getElementById('xgBars').innerHTML = svg2+'</svg>';

  // heatmaps
  document.getElementById('heatmaps').innerHTML = M.map(m=>`
    <div><div style="font-weight:700;font-size:13.5px;margin-bottom:6px">${m.home} – ${m.away}</div>
    <div class="heat">${(()=>{
      const max=m.model_cs[0].p; let h='';
      for(let x=0;x<5;x++) for(let y=0;y<5;y++){
        const c=m.heat.find(z=>z.s===`${x}-${y}`)||{p:0};
        const a=Math.min(1,c.p/(max||1));
        h+=`<div style="background:rgba(34,227,164,${(a*.95).toFixed(2)});color:${a>.5?'#04121a':'#cfe8ff'}"
          title="${x}-${y}: ${pct(c.p,2)}">${c.p>=0.035?(c.p*100).toFixed(0):''}</div>`;
      }
      return h;})()}</div></div>`).join('');
})();
</script>
</body>
</html>
